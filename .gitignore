node_modules/
dist/
.env
.env.local
.env.*.local
*.log
.DS_Store
*.bak
*.bak/
locales.bak/

# Supabase CLI working directory
supabase/.temp/
supabase/.branches/
supabase/.env

# Patches et scripts de migration ponctuels
*.patch
fix-*.py
rename-*.py
migrate-*.py
# Variables d'environnement (clés API, secrets)
.env
.env.local
.env.production

# Sources de conversion fontaire (.ttf téléchargés depuis Google Fonts pour subsetting woff2)
fonts-source/

# Archives temporaires d'audit (zip envoyés à Claude pour lecture)
notify-functions.zip

# Fichier test eslint
eslint-first-run.txt

# Logs ESLint temporaires
eslint-first-run.txt

# Backups générés par les scripts PowerShell de patching
*.bak-*

# Sauvegardes locales temporaires des sessions de patch (nettoyage 13/05)
*.bak.*
# Fichiers brises temporaires (refactor en cours, debug)
*.broken*

# Scripts one-shot Claude (creation de migrations, ne pas commit)
create-*.cjs
fix-*.cjs

# Dumps Supabase archives en local (recuperation si une migration echoue).
# Le dossier docs/db/ n est pas versionne, sauf son README explicatif.
docs/db/*
!docs/db/README.md

# Donn�es cartographiques priv�es � non publiables tant que les collectifs
# n'ont pas valid� leur apparition (cf. d�finition du membre AnarBib, 27/05/2026)
# Seul le document public de recensement est versionn�.
docs/cartographie/*
!docs/cartographie/AnarBib_recensement_bibliotheques_libertaires.docx

# OCR navigateur (piste B) — assets WASM tesseract.js vendorisés localement.
# Régénérés par scripts/install-tesseract.sh ; cible prod = bucket
# anarbib-media-public/ocr/ (cadrage §2/§8). On versionne le script + la note
# VERSION, jamais les ~13 Mo de WASM/traineddata.
public/vendor/tesseract/*.wasm.js
public/vendor/tesseract/worker.min.js
public/vendor/tesseract/worker.min.js.LICENSE.txt
public/vendor/tesseract/lang/

# Fichiers temporaires / verrou MS Office
~$*

# Config de sauvegarde REMPLIE (#BG2) : secrets DB/restic — jamais committer.
# Seul le .example (sans secret) est versionné.
scripts/backup/*.env
*.pass

# Dossier de passation inter-sessions (briefs, notes, copies de travail) — local,
# non versionné. Évite que les captures « modifs en cours » du worktree partagé
# le ré-empaquettent à chaque fois (cf. coordination 24/06).
_handoff/

# Outillage Claude Code (CLAUDE.md + .claude/) : passage au codage à la main.
# Conservés uniquement en local, hors suivi git — retirés du dépôt le 2026-07-07.
/CLAUDE.md
/.claude/

# Instantané du catalogue pour le mode dégradé : régénéré à chaque build
# (npm run prebuild). Pas versionné pour éviter un fichier de ~300 ko qui
# changerait à chaque déploiement.
public/catalogue-snapshot.json

# Pile auto-hebergee (secrets) — ajoute le 2026-08-17, corrige le 2026-08-18.
# Seuls les fichiers REMPLIS sont ignores ; les modeles .example sont versionnes,
# faute de quoi le dossier deploy/ n'est pas utilisable depuis un clone frais.
deploy/.env
deploy/functions.env
# NOTE 2026-08-18 : genkeys.mjs etait ignore par erreur. Il ne contient AUCUN
# secret — il en genere, et les ecrit dans .env sans jamais les afficher. Sans
# lui, on ne peut pas reconstruire l'installation depuis le depot, ce qui est
# exactement ce qu'on affirme savoir faire. Il est donc versionne.

# Sauvegardes de production : DONNEES PERSONNELLES EN CLAIR.
# Ne doivent jamais approcher le depot. Ajoute le 2026-08-18.
# On ignore le CONTENU du dossier, pas le dossier : son LISEZ-MOI est versionne
# pour que l'avertissement existe dans un clone frais, et pour que le dossier
# attendu par scripts/restore.sh soit present.
deploy/dumps/*
!deploy/dumps/LISEZ-MOI.txt
*.dump
*.sql.gz

# ============================================================================
# Config de anarbib-backup.sh — COPIER en anarbib-backup.env et REMPLIR.
# ⚠️ Ce fichier rempli contient des secrets : NE PAS committer (cf. .gitignore),
#    chmod 600, et idéalement stocker hors du dépôt sur le VPS.
# ============================================================================

# --- Base Postgres ----------------------------------------------------------
# Chaîne de connexion (pooler Supabase, port 5432 ou 6543). Récupérable dans :
# Dashboard Supabase -> Project Settings -> Database -> Connection string (URI).
# Utiliser de préférence un rôle en LECTURE SEULE dédié aux sauvegardes.
SUPABASE_DB_URL="postgresql://postgres:MOTDEPASSE@db.uflwmikiyjfnikiphtcp.supabase.co:5432/postgres"

# --- Dépôt restic (la destination chiffrée) ---------------------------------
# Exemples :
#   sftp:backup@vps-lille.example.org:/srv/backups/anarbib
#   sftp:backup@vps-lyon.example.org:/srv/backups/anarbib
#   /mnt/hdd-2to/restic-anarbib                (disque externe = copie froide)
RESTIC_REPOSITORY="sftp:backup@vps-lille.example.org:/srv/backups/anarbib"

# Fichier contenant le mot de passe du dépôt restic (chmod 600).
# ⚠️ SAUVEGARDER CE MOT DE PASSE À PART (gestionnaire + copie hors-ligne) :
#    sans lui, les sauvegardes chiffrées sont DÉFINITIVEMENT illisibles.
RESTIC_PASSWORD_FILE="/etc/anarbib/restic.pass"

# --- Storage (endpoint S3 de Supabase, via rclone) --------------------------
# Configurer une remote rclone (rclone config) de type s3 :
#   provider = Other
#   endpoint = https://uflwmikiyjfnikiphtcp.supabase.co/storage/v1/s3
#   region   = (cf. dashboard, ex: eu-central-1)
#   access_key_id / secret_access_key = Dashboard -> Storage -> S3 Access Keys
# Puis indiquer ici la remote (avec ':' final = tous les buckets) :
RCLONE_REMOTE="supabase-s3:"

# --- Secrets / config hors git (optionnel mais recommandé) ------------------
# Dossier local contenant .env.local, secrets des Edge Functions, etc.
# Laisser vide pour ne pas les inclure.
SECRETS_DIR=""

# --- Divers -----------------------------------------------------------------
STAGING_DIR="/tmp/anarbib-backup-staging"
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
# URL webhook (Slack/Matrix/ntfy…) pingée si la sauvegarde échoue (optionnel) :
FAIL_WEBHOOK=""

# /etc/anarbib/sauvegarde.env — configuration de anarbib-vm-sauvegarde.sh
# Mode 600, propriétaire root. Aucune de ces valeurs ne va au dépôt.

# Dossier du dépôt AnarBib cloné sur la machine (celui où tourne deploy/compose.yml)
ANARBIB_DIR=/opt/anarbib

# Dépôt restic, OBLIGATOIREMENT hors de cette machine. Exemples :
#   sftp:sauvegarde@autre-machine.example.org:/data/anarbib   (clé SSH dédiée, sans passphrase, via ~/.ssh/config de root)
#   rest:https://rest-server.example.org/anarbib
#   s3:https://s3.example.org/anarbib-sauvegarde              (+ AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY ci-dessous)
RESTIC_REPOSITORY=

# Passphrase du dépôt : un fichier, mode 600, créé par `openssl rand -base64 48 > /etc/anarbib/restic.pass`.
# La garder AUSSI ailleurs (gestionnaire de mots de passe) : sans elle, le dépôt est illisible.
RESTIC_PASSWORD_FILE=/etc/anarbib/restic.pass

# Pour un dépôt S3 seulement
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# Nom du projet Compose (le `name:` de deploy/compose.yml) — ne change que si vous l'avez renommé
#COMPOSE_PROJECT=anarbib-selfhost

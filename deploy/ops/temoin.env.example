# ~/anarbib-ops/temoin.env — configuration du temoin de panne (deploy/ops/anarbib-temoin.sh, I31).
# Jamais au depot. A poser par la personne qui tient le poste, en mode 600 :
#   umask 077 && install -m 600 /dev/null ~/anarbib-ops/temoin.env
# puis y ecrire les valeurs (la cle a l'invite masquee, jamais dans l'historique du terminal).
# Seuls les NOMS figurent ici.

# La cle d'API de Resend — la meme que le secret RESEND_API_KEY des fonctions Edge.
RESEND_API_KEY=
# Qui prevenir : les adresses des administrateur·rices du reseau, separees par des virgules.
TEMOIN_DESTINATAIRES=
# L'expediteur, sur le domaine d'envoi verifie chez Resend : « AnarBib <adresse> »
# (la meme adresse que le secret SENDER_EMAIL des fonctions Edge).
TEMOIN_EXPEDITEUR=

# Facultatif — les defauts conviennent a la production :
# TEMOIN_PROJET=https://uflwmikiyjfnikiphtcp.supabase.co
# TEMOIN_SEUIL_ECHECS=2         # echecs de suite avant d'ecrire (2 x 5 min)
# TEMOIN_DELAI_S=20             # delai d'attente d'une sonde, en secondes
# TEMOIN_URL_CONTROLE=https://codeberg.org/
# TEMOIN_FUSEAU=Europe/Paris

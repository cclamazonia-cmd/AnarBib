# =============================================================================
# Secrets des Edge Functions — MODÈLE
# =============================================================================
# COPIER en functions.env et REMPLIR. Le fichier rempli est ignoré par git.
#
#   Windows :  copy functions.env.example functions.env
#   Linux   :  cp   functions.env.example functions.env
#
# Pour une RÉPÉTITION LOCALE, des valeurs factices suffisent : le runtime
# démarre, mais aucun courriel n'est envoyé et aucune API réelle n'est appelée.
# Pour un DÉPLOIEMENT RÉEL, poser les vraies valeurs (cf. .env.example à la
# racine du dépôt, qui fait référence).
# =============================================================================

# --- Transport e-mail -------------------------------------------------------
# AUJOURD'HUI, un seul transport est lu par les fonctions serveur : Resend.
# Sans RESEND_API_KEY, chaque envoi lève « RESEND_API_KEY absente » (aucun
# courriel ne part, et ça se voit).
MAIL_TRANSPORT=resend
RESEND_API_KEY=
SENDER_EMAIL=
SENDER_NAME=AnarBib

# À VENIR (transport hybride, backlog F7 — ex-PR #29) : SMTP standard et
# simulation locale sur MAIL_TRANSPORT=mock explicite. Ces variables sont
# posées pour ce jour-là ; les fonctions serveur ne les lisent pas encore.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false


# --- Webhooks internes ------------------------------------------------------
# Les fonctions déclarées verify_jwt=false dans supabase/config.toml sont
# authentifiées par l'en-tête x-webhook-secret. Ces valeurs sont donc de
# véritables secrets : une chaîne aléatoire longue par webhook.
WEBHOOK_SECRET_NOTIFY_EVENT=
WEBHOOK_SECRET_NOTIFY_OAI_OPENING=
WEBHOOK_SECRET_NOTIFY_DIGITAL_SHARE=
NOTIFY_INTERLIBRARY_LOAN_WEBHOOK_SECRET=
WEBHOOK_SECRET_NOTIFY_INTERNAL_TASK=

# --- Fonctions éditoriales --------------------------------------------------
# Utilisées UNIQUEMENT par gazette-monthly-build et
# translate-gazette-submission. Ni le catalogue ni la circulation n'en dépendent :
# la pile fonctionne intégralement sans ces deux clés.
ANTHROPIC_API_KEY=
GAZETTE_CRON_SECRET=

# --- Anti-robots (Altcha, auto-hébergé) -------------------------------------
# Secret de signature des défis de preuve de travail. Une chaîne aléatoire
# longue, 32 caractères minimum — la fonction refuse de démarrer en dessous.
# Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Le CHANGER invalide tous les défis en circulation : les personnes en train de
# remplir un formulaire devront recommencer. Sans gravité, mais à éviter aux
# heures d'affluence.
#
# Remplace TURNSTILE_SECRET_KEY, retiré le 2026-08-20 : plus aucun appel sortant
# vers Cloudflare. Cf. docs/journal/arbitrages/DECISION_anti_robots_2026-08-20.md
ALTCHA_HMAC_SECRET=

# --- Services externes ------------------------------------------------------
ACOUSTID_API_KEY=
# Géocodage auto-hébergé (cf. scripts/nominatim/). Doctrine anti-pistage :
# ne jamais pointer vers nominatim.openstreetmap.org depuis la production.
NOMINATIM_URL=

# --- Origine du front (CORS des formulaires publics) ------------------------
# Trois fonctions (géocodage, cartographie, brèves de la gazette) ne répondent
# qu'à NOTRE front. Par défaut : app.anarbib.org et ses routes de repli. Sur une
# pile auto-hébergée, poser ici l'adresse (ou les adresses, séparées par des
# virgules) où votre front est servi — sinon ces trois formulaires échouent au
# contrôle d'origine du navigateur. Exemple : https://biblio.mon-collectif.org
APP_ALLOWED_ORIGINS=

# --- Marque et fuseau -------------------------------------------------------
APP_BASE_URL=
# Site de présentation cité dans les mails (guide d'accueil, galerie). Vide = https://anarbib.org.
SITE_BASE_URL=
BRAND_NAME=AnarBib
DEFAULT_NOTIFICATION_TIMEZONE=America/Sao_Paulo

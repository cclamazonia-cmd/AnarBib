# =============================================================================
# AnarBib self-hosted — variables de la pile (fichier `.env` à côté de compose.yml)
# =============================================================================
# Ce fichier ne contient QUE ce dont la pile a besoin pour démarrer.
# Les secrets des Edge Functions (RESEND_API_KEY, WEBHOOK_SECRET_*, etc.) vont
# dans `functions.env` — reprendre la liste du `.env.example` du dépôt.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. VERSIONS ÉPINGLÉES  — aucun `latest`, jamais.
# -----------------------------------------------------------------------------
# Ces valeurs sont celles de la répétition du 18/08, VALIDÉES de bout en bout.
# Elles vivent ici et non dans `.env` : ce ne sont pas des secrets, et un
# fichier ignoré par git n'est pas un endroit où ranger la seule trace des
# versions qui font tourner la pile.
#
# CE QUI S'EST PASSÉ (20/08). Elles n'étaient QUE dans `deploy/.env`, ignoré
# par git. Ce fichier a disparu de la machine, et avec lui les six versions :
# `.env.example` était vide, `REPETITION.md` ne montrait que des gabarits
# (`v2.xxx.x`), et il ne restait qu'une trace incidente dans un commentaire de
# `bootstrap.sh`. Elles ont été reconstituées depuis le cache d'images Docker —
# une seule image par nom de dépôt utilisé par compose.yml, donc sans
# ambiguïté — et recoupées avec ce commentaire et le §7.2 du plan de marche.
# La pile ne se reconstruisait pas depuis le dépôt : elle se reconstruisait
# depuis un cache local. Ce n'est plus le cas.
#
# Une fois la pile validée, remplacer chaque tag par son digest sha256 : c'est
# ce qui rend la reconstruction identique à l'octet près.
POSTGRES_TAG=17.6.1.136
POSTGREST_TAG=v14.12
# GOTRUE : v2.189.0 -> v2.192.0 le 20/08/2026. Règle : image ≥ production.
#
# La production enregistre 77 migrations `auth`, la dernière `20260625000000`
# (add_custom_claims_allowlist). L'image v2.189.0 ne la porte PAS — sa plus
# récente est `20260302000000` (add_passkeys). v2.192.0 est la PREMIÈRE version
# qui l'embarque : v2.190.0 et v2.191.0 ne l'ont pas. On monte donc du minimum
# nécessaire, pas jusqu'au dernier tag.
#
# ⚠️ Ne pas comparer 69 à 77 : ce sont deux grandeurs différentes, et c'est
# l'erreur du §7.2 du plan de marche. 69 = le nombre de FICHIERS de migration
# embarqués dans l'image ; 77 = le nombre de LIGNES dans
# `auth.schema_migrations`, table qui garde l'historique de versions que les
# images actuelles ne portent plus. Le bon test n'est pas un décompte : c'est
# « l'image contient-elle la version que la production déclare comme dernière ? »
#
# Vérifié en réel le 20/08 sur la pile locale : v2.189.0 s'arrêtait à 76 lignes
# / `20260302000000` ; après passage à v2.192.0, 77 lignes / `20260625000000`,
# soit exactement la production.
GOTRUE_TAG=v2.192.0
# STORAGE — même règle que GoTrue, et elle a mordu au même endroit.
#
# Constaté le 26/08/2026, en restaurant un dump de production RÉEL (une
# répétition à vide ne pouvait pas le voir) :
#
#   ERROR: column "versioning_status" of relation "buckets" does not exist
#
# La production porte 65 migrations Storage ; `v1.60.4` n'en construit que 61,
# et `storage.buckets` y manque `versioning_status`. Le chargement des données
# mourait donc dès la première ligne de buckets — c'est-à-dire sur tout dump
# réel, puisque la production a seize buckets.
#
# Mesuré au banc, une base vierge par palier :
#   v1.60.4   → 61 migrations, versioning_status ABSENT
#   v1.67.29  → 61 migrations, versioning_status ABSENT
#   v1.69.0   → 62 migrations, versioning_status ABSENT
#   v1.69.11  → 62 migrations, versioning_status ABSENT
#   v1.70.0   → 63 migrations, versioning_status présent — mais SOUS la
#               production : la colonne suffit au dump du jour, pas la règle
#   v1.70.7   → 65 migrations, colonnes IDENTIQUES à la production ← retenu
#   v1.71.0   → 65 migrations (inutile de monter plus haut)
#
# Concordance vérifiée table par table sur buckets, objects, buckets_analytics,
# s3_multipart_uploads et s3_multipart_uploads_parts : jeux de colonnes égaux.
# `vector-buckets`, la dernière migration côté production, est bien présente.
#
# RÈGLE : image ≥ production, jamais l'inverse. On monte du minimum nécessaire.
STORAGE_TAG=v1.70.7
EDGE_RUNTIME_TAG=v1.74.0
# Seule entorse à la règle du §1 : un tag majeur. Caddy est le seul service sans
# schéma ni données — une mineure ne change rien à la reconstruction. À épingler
# au tag exact le jour de la répétition finale (valeur de `docker image inspect`).
CADDY_TAG=2

# -----------------------------------------------------------------------------
# 2. SECRETS DE LA PILE
# -----------------------------------------------------------------------------
# Mot de passe Postgres — générer : openssl rand -base64 36
POSTGRES_PASSWORD=

# Secret de signature des JWT — au moins 32 caractères.
# Générer : openssl rand -base64 48
# ⚠️ Changer ce secret invalide TOUTES les sessions en cours.
JWT_SECRET=
JWT_EXPIRY=3600

# Clés dérivées du JWT_SECRET (rôles `anon` et `service_role`).
# Se génèrent avec le secret ci-dessus — cf. README §« Générer les clés ».
# ANON_KEY est publique (embarquée dans le bundle front).
# SERVICE_ROLE_KEY est un secret serveur : jamais dans le front, jamais commitée.
ANON_KEY=
SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 3. DOMAINES
# -----------------------------------------------------------------------------
# Domaine de la passerelle API sur la VM (enregistrement A vers son IP).
API_DOMAIN=api.anarbib.org
API_EXTERNAL_URL=https://api.anarbib.org

# Domaine du front (Codeberg Pages ou ailleurs) — sert aux redirections d'auth.
SITE_URL=https://app.anarbib.org
URI_ALLOW_LIST=https://app.anarbib.org,https://app.anarbib.org/*

# -----------------------------------------------------------------------------
# 4. RÉGLAGES
# -----------------------------------------------------------------------------
# Schémas exposés par PostgREST. `api` porte les RPC publiques ; `public` est
# nécessaire pour les tables lues directement par le front.
# ⚠️ À CONFIRMER contre la configuration Supabase actuelle avant bascule.
PGRST_DB_SCHEMAS=public,api,storage

# Taille max d'un fichier versé (documents numérisés : 5 à 50 Mo observés).
STORAGE_FILE_SIZE_LIMIT=52428800

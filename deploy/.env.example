# =============================================================================
# AnarBib self-hosted — variables de la pile (fichier `.env` à côté de compose.yml)
# =============================================================================
# Ce fichier ne contient QUE ce dont la pile a besoin pour démarrer.
# Les secrets des Edge Functions (RESEND_API_KEY, WEBHOOK_SECRET_*, etc.) vont
# dans `functions.env` — reprendre la liste du `.env.example` du dépôt.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. VERSIONS ÉPINGLÉES  — aucun `latest`, jamais.
# -----------------------------------------------------------------------------
# Ces valeurs sont celles de la répétition du 18/08, VALIDÉES de bout en bout.
# Elles vivent ici et non dans `.env` : ce ne sont pas des secrets, et un
# fichier ignoré par git n'est pas un endroit où ranger la seule trace des
# versions qui font tourner la pile.
#
# CE QUI S'EST PASSÉ (20/08). Elles n'étaient QUE dans `deploy/.env`, ignoré
# par git. Ce fichier a disparu de la machine, et avec lui les six versions :
# `.env.example` était vide, `REPETITION.md` ne montrait que des gabarits
# (`v2.xxx.x`), et il ne restait qu'une trace incidente dans un commentaire de
# `bootstrap.sh`. Elles ont été reconstituées depuis le cache d'images Docker —
# une seule image par nom de dépôt utilisé par compose.yml, donc sans
# ambiguïté — et recoupées avec ce commentaire et le §7.2 du plan de marche.
# La pile ne se reconstruisait pas depuis le dépôt : elle se reconstruisait
# depuis un cache local. Ce n'est plus le cas.
#
# Une fois la pile validée, remplacer chaque tag par son digest sha256 : c'est
# ce qui rend la reconstruction identique à l'octet près.
POSTGRES_TAG=17.6.1.136
POSTGREST_TAG=v14.12
GOTRUE_TAG=v2.189.0
STORAGE_TAG=v1.60.4
EDGE_RUNTIME_TAG=v1.74.0
CADDY_TAG=2

# -----------------------------------------------------------------------------
# 2. SECRETS DE LA PILE
# -----------------------------------------------------------------------------
# Mot de passe Postgres — générer : openssl rand -base64 36
POSTGRES_PASSWORD=

# Secret de signature des JWT — au moins 32 caractères.
# Générer : openssl rand -base64 48
# ⚠️ Changer ce secret invalide TOUTES les sessions en cours.
JWT_SECRET=
JWT_EXPIRY=3600

# Clés dérivées du JWT_SECRET (rôles `anon` et `service_role`).
# Se génèrent avec le secret ci-dessus — cf. README §« Générer les clés ».
# ANON_KEY est publique (embarquée dans le bundle front).
# SERVICE_ROLE_KEY est un secret serveur : jamais dans le front, jamais commitée.
ANON_KEY=
SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 3. DOMAINES
# -----------------------------------------------------------------------------
# Domaine de la passerelle API sur la VM (enregistrement A vers son IP).
API_DOMAIN=api.anarbib.org
API_EXTERNAL_URL=https://api.anarbib.org

# Domaine du front (Codeberg Pages ou ailleurs) — sert aux redirections d'auth.
SITE_URL=https://app.anarbib.org
URI_ALLOW_LIST=https://app.anarbib.org,https://app.anarbib.org/*

# -----------------------------------------------------------------------------
# 4. RÉGLAGES
# -----------------------------------------------------------------------------
# Schémas exposés par PostgREST. `api` porte les RPC publiques ; `public` est
# nécessaire pour les tables lues directement par le front.
# ⚠️ À CONFIRMER contre la configuration Supabase actuelle avant bascule.
PGRST_DB_SCHEMAS=public,api,storage

# Taille max d'un fichier versé (documents numérisés : 5 à 50 Mo observés).
STORAGE_FILE_SIZE_LIMIT=52428800

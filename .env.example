# =============================================================================
# AnarBib — Référence des variables d'environnement / secrets  (.env.example)
# =============================================================================
# Ce fichier N'EST PAS chargé par l'application. C'est la carte de référence
# « jour-J » des variables à poser. Copie-le, remplis les valeurs, et pose-les
# via le bon canal (jamais committer les valeurs réelles) :
#
#   • Front (VITE_*)  → variables de BUILD (Codeberg Pages / CI ou .env.local).
#                       Publiques par nature (embarquées dans le bundle) —
#                       n'y mets QUE des clés destinées au navigateur (anon key,
#                       site key Turnstile...), jamais un secret serveur.
#   • Edge Functions  → `supabase secrets set --env-file <fichier>`
#                       (ou une par une : `supabase secrets set NOM=valeur`).
#                       Sur VPS self-hosted : variables d'env du runtime Deno.
#
# Généré le 2026-07-03 par balayage de tous les `Deno.env.get(...)` du code
# (supabase/functions/**) et des `import.meta.env.VITE_*` (src/**).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. FRONT-END  (build-time, PUBLIC — embarqué dans le bundle)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<clé anon publiable>
# Clé PUBLIQUE (site key) du captcha Cloudflare Turnstile — inscription/login/carto.
VITE_TURNSTILE_SITE_KEY=<turnstile site key>
# Domaine Jitsi pour l'entraide / assemblées (accord A/I : vc.autistici.org).
VITE_JITSI_DOMAIN=vc.autistici.org


# -----------------------------------------------------------------------------
# 2. EDGE FUNCTIONS — fournis par la plateforme Supabase
# -----------------------------------------------------------------------------
# AUTO-injectés sur Supabase hébergé (rien à faire).
# À FOURNIR SOI-MÊME uniquement en self-hosted / VPS.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<clé anon>
SUPABASE_SERVICE_ROLE_KEY=<clé service_role — SECRET, jamais côté front>


# -----------------------------------------------------------------------------
# 3. EDGE FUNCTIONS — OBLIGATOIRES (sans elles, ça casse)
# -----------------------------------------------------------------------------
# Transport e-mail (Resend). Sans clé, tout envoi throw.
RESEND_API_KEY=<resend api key>
# Auth du dispatcher central notify-event (pivot de toutes les notifications).
WEBHOOK_SECRET_NOTIFY_EVENT=<secret partagé cron/RPC ↔ notify-event>
# Expéditeur. ATTENTION : défaut codé = no-reply@example.org → À ÉCRASER,
# sinon mails rejetés / spam. Le domaine doit être vérifié dans Resend (cf. §6 DNS).
SENDER_EMAIL=no-reply@anarbib.org
SENDER_NAME=Biblioteca da rede AnarBib


# -----------------------------------------------------------------------------
# 4. EDGE FUNCTIONS — WEBHOOK SECRETS par notifieur spécialisé
# -----------------------------------------------------------------------------
# Chaque flux tombe en silence sans le sien. Valeurs indépendantes recommandées.
WEBHOOK_SECRET_NOTIFY_OAI_OPENING=<secret notify-oai-opening>
WEBHOOK_SECRET_NOTIFY_DIGITAL_SHARE=<secret notify-digital-share>
NOTIFY_INTERLIBRARY_LOAN_WEBHOOK_SECRET=<secret notify-interlibrary-loan>
WEBHOOK_SECRET_NOTIFY_INTERNAL_TASK=<secret notify-internal-task>


# -----------------------------------------------------------------------------
# 5. EDGE FUNCTIONS — FEATURES spécifiques
# -----------------------------------------------------------------------------
# Gazette : génération + traduction des brèves (crons gazette-monthly-build /
# gazette-translate-submissions ACTIFS → ces deux secrets DOIVENT être posés).
ANTHROPIC_API_KEY=<clé API Anthropic>
GAZETTE_CRON_SECRET=<secret d'appel des EF gazette>
# Captcha serveur (validation) — register / login / submit-cartography-entry.
TURNSTILE_SECRET_KEY=<turnstile secret key>
# Empreinte audio (audio_fingerprint_lookup).
ACOUSTID_API_KEY=<acoustid api key>
# Géocodage (geocode) — instance Nominatim (cf. scripts/nominatim/).
NOMINATIM_URL=https://<nominatim host>


# -----------------------------------------------------------------------------
# 6. EDGE FUNCTIONS — BRANDING / OPTIONNELS (ont un fallback codé)
# -----------------------------------------------------------------------------
# Non bloquants, mais à régler pour un rendu correct des e-mails.
APP_BASE_URL=https://app.anarbib.org        # défaut codé identique
ADMIN_EMAIL=<email admin réseau/biblio>
ADMIN_NAME=Equipe da biblioteca
REPLY_TO_EMAIL=<email de réponse>
BRAND_NAME=AnarBib
LOGO_URL=<url logo pour en-tête mail>
FOOTER_TEXT=<pied de page mail>
REGIMENTO_URL=<url règlement intérieur>
LIBRARIAN_PHONE=<téléphone contact>
DEFAULT_NOTIFICATION_TIMEZONE=America/Sao_Paulo
# TTL des URLs signées (défauts codés si absents).
ILL_SIGNED_URL_TTL_SECONDS=
DIGITAL_ASSET_SIGNED_URL_TTL_SECONDS=

# NB : le routage e-mail réel est per-bibliothèque (resolveMailRouting) ; les
# anciens fallbacks NETWORK_*/LIBRARY_*/ANARBIB_*/BLMF_* restent lus mais sont
# alignés sur le couple canonique SENDER_EMAIL / SENDER_NAME (harmonisation R.7,
# 08/06/2026). Ne les repose que si tu as un vrai besoin de surcharge locale.


# =============================================================================
# 7. DNS — à ne pas oublier (délivrabilité e-mail via Resend)
# =============================================================================
#  a) Domaine expéditeur (celui de SENDER_EMAIL) VÉRIFIÉ dans Resend :
#     publier les enregistrements DKIM (CNAME/TXT) fournis par Resend,
#     un SPF (TXT) autorisant Resend, et un DMARC (TXT, ex. p=quarantine).
#     → Tant qu'on reste sur Resend : PAS besoin de PTR/reverse-DNS ni de
#       gérer une réputation IP (ce ne deviendrait nécessaire qu'avec un
#       SMTP interne).
#  b) app.anarbib.org → CNAME/A vers l'hébergeur du front (Codeberg Pages).
#     APP_BASE_URL et tous les liens des mails en dépendent.
#  c) (self-hosted VPS uniquement) domaine de la passerelle API (ex.
#     api.anarbib.org) → A vers l'IP du VPS + TLS (Caddy/Traefik + Let's Encrypt).
# =============================================================================
